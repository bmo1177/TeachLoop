# ---------------------------------------------------------------
# AI evaluation provider — pick ONE (both optional).
# With no keys configured, TeachLoop runs in demo mode with
# deterministic mock evaluation (clearly labeled in the UI).
# ---------------------------------------------------------------

# NVIDIA NIM (recommended, free endpoint, ~1-3s responses)
# Get a key: https://build.nvidia.com/experiments
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional model override (default: nvidia/nemotron-3.5-bolt-e4b)
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# OpenRouter fallback (used only when NVIDIA_API_KEY is absent)
# Get a key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
